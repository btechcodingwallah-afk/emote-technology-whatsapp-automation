        "jsonBody": "={{ JSON.stringify({ tenantId: $json.event.tenantId, connectionId: $json.event.connectionId, to: $json.event.customerPhone, type: 'text', message: { type: 'text', text: { body: $json.replyText } } }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-auto-reply",
      "name": "Send Auto Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 420],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Log the result\nconst sendResult = $input.first().json;\nconst event = $('Process Message').first().json.event;\n\nreturn [{ json: {\n  status: 'completed',\n  action: 'handoff',\n  tenantId: event.tenantId,\n  customerPhone: event.customerPhone,\n  sendSuccess: sendResult.success !== false,\n  error: sendResult.error || null\n}}];"
      },
      "id": "handoff-result",
