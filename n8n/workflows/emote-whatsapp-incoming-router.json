    {
      "parameters": {
        "jsCode": "// ============================================\n// ROUTE TO AUTOMATION ENGINE\n// ============================================\nconst event = $('Validate Payload').first().json.event;\nconst configResponse = $input.first().json;\n\n// Default config if fetch failed\nconst config = configResponse.config || {\n  enabled: true,\n  mode: 'AUTO',\n  welcomeMessage: 'Hello! How can we help you?',\n  humanHandoffEnabled: true,\n  humanHandoffKeywords: ['human', 'agent', 'person', 'help'],\n  humanHandoffMessage: 'Connecting you with a team member.',\n  fallbackMessage: 'Sorry, I did not understand that.',\n  maxAutoRepliesPerConversation: 50,\n  aiEnabled: false,\n};\n\n// Check if automation is enabled\nif (!config.enabled) {\n  return [{ json: { action: 'skip', reason: 'Automation disabled for tenant', event } }];\n}\n\n// Check conversation status from metadata\nconst conversationStatus = event.metadata?.conversationStatus;\nif (conversationStatus === 'HUMAN_HANDOFF') {\n  return [{ json: { action: 'skip', reason: 'Conversation in human handoff', event } }];\n}\n\n// Check auto-reply limit\nconst autoReplyCount = event.metadata?.autoReplyCount || 0;\nif (autoReplyCount >= config.maxAutoRepliesPerConversation) {\n  return [{ json: { action: 'skip', reason: 'Auto-reply limit reached', event } }];\n}\n\n// Pass everything to the automation engine\nreturn [{ json: { action: 'process', event, config } }];"
      },
