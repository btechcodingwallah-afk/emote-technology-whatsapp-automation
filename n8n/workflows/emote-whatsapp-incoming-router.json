      "parameters": {
        "jsCode": "// ============================================\n// VALIDATE REQUIRED FIELDS\n// ============================================\nconst event = $json.event;\n\nconst required = ['tenantId', 'connectionId', 'phoneNumberId', 'messageId', 'eventCategory'];\nconst missing = required.filter(f => !event[f]);\n\nif (missing.length > 0) {\n  return [{ json: { valid: false, error: `Missing required fields: ${missing.join(', ')}`, event } }];\n}\n\n// Only allow real incoming customer messages (ignore delivery receipts/status updates)\nif (event.eventCategory !== 'message') {\n  return [{ json: { valid: false, error: `Non-message event category: ${event.eventCategory}`, event } }];\n}\n\nreturn [{ json: { valid: true, event } }];"
      },
