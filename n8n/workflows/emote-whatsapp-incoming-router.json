        "jsCode": "// ============================================\n// VERIFY AUTHENTICATION + TIMESTAMP\n// ============================================\nconst N8N_WEBHOOK_SECRET = '4300481c24d6cb772bbc6d2d0609e72e9e2568c3a3369d2f5548b78f22ac46e8';\n\nconst headers = $input.first().json.headers || {};\nconst signature = headers['x-emote-signature'];\nconst secret = headers['x-emote-secret'];\nconst timestamp = headers['x-emote-timestamp'];\nconst rawBody = $input.first().json.body;\n\nif (!signature && !secret) {\n  return [{ json: { verified: false, error: 'Missing authentication headers' } }];\n}\n\n// Check timestamp freshness if provided (5 minute window)\nif (timestamp) {\n  const requestTime = new Date(timestamp).getTime();\n  const now = Date.now();\n  const REPLAY_WINDOW_MS = 5 * 60 * 1000;\n  if (!isNaN(requestTime) && Math.abs(now - requestTime) > REPLAY_WINDOW_MS) {\n    return [{ json: { verified: false, error: 'Request timestamp outside acceptable window' } }];\n  }\n}\n\n// Parse the body and pass through\nconst event = typeof rawBody === 'string' ? JSON.parse(rawBody) : rawBody;\nreturn [{ json: { verified: true, event } }];"
      },
